<style>
  .rods-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 3;
    padding-right: 3;
    background-color: rgba(0, 10, 20, 0.95);
    border-color: #ffaa00;
    border-width: 0.1;
    border-radius: 1.5;
  }
  .heading { font-size: 2.5; color: #ffaa00; font-weight: bold; }
  .rod-entry {
    display: flex;
    flex-direction: row;
    margin-top: 0.6;
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 1.5;
    padding-right: 1.5;
    background-color: rgba(40, 20, 0, 0.4);
    border-color: #664400;
    border-width: 0.03;
    border-radius: 0.4;
    cursor: pointer;
  }
  .rod-name { font-size: 1.3; color: #ffaa00; font-weight: bold; }
  .rod-status { font-size: 1.1; color: #668888; margin-left: 1; }
  .back-btn {
    margin-top: 1;
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(60, 30, 0, 0.6);
    border-color: #ffaa00;
    border-width: 0.05;
    border-radius: 0.5;
    cursor: pointer;
  }
  .back-text { font-size: 1.3; color: #ffaa00; }
</style>
<div class="rods-panel">
  <span class="heading">FISHING RODS</span>
  <div id="btn-rod-0" class="rod-entry"><span id="rod-name-0" class="rod-name">Starter Rod</span><span id="rod-status-0" class="rod-status">EQUIPPED</span></div>
  <div id="btn-rod-1" class="rod-entry"><span id="rod-name-1" class="rod-name">Speed Rod</span><span id="rod-status-1" class="rod-status">LOCKED</span></div>
  <div id="btn-rod-2" class="rod-entry"><span id="rod-name-2" class="rod-name">Power Rod</span><span id="rod-status-2" class="rod-status">LOCKED</span></div>
  <div id="btn-rod-3" class="rod-entry"><span id="rod-name-3" class="rod-name">Lucky Rod</span><span id="rod-status-3" class="rod-status">LOCKED</span></div>
  <div id="btn-rod-4" class="rod-entry"><span id="rod-name-4" class="rod-name">Master Rod</span><span id="rod-status-4" class="rod-status">LOCKED</span></div>
  <div id="btn-back-rods" class="back-btn">
    <span class="back-text">BACK</span>
  </div>
</div>
