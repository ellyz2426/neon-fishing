<style>
  .go-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 3;
    padding-right: 3;
    background-color: rgba(0, 10, 20, 0.95);
    border-color: #ff4444;
    border-width: 0.1;
    border-radius: 1.5;
  }
  .heading { font-size: 3; color: #ff4444; font-weight: bold; }
  .mode-text { font-size: 1.3; color: #668888; margin-top: 0.5; }
  .stat-row { display: flex; flex-direction: row; margin-top: 0.5; }
  .label { font-size: 1.2; color: #668888; }
  .value { font-size: 1.4; color: #00ffff; font-weight: bold; margin-left: 0.5; }
  .score-big { font-size: 3; color: #ffaa00; font-weight: bold; margin-top: 1; }
  .btn {
    margin-top: 1;
    padding-top: 0.7;
    padding-bottom: 0.7;
    padding-left: 2.5;
    padding-right: 2.5;
    background-color: rgba(0, 60, 60, 0.6);
    border-color: #00ffff;
    border-width: 0.05;
    border-radius: 0.5;
    cursor: pointer;
  }
  .btn-text { font-size: 1.5; color: #00ffff; font-weight: bold; }
  .btn-orange { background-color: rgba(60, 30, 0, 0.6); border-color: #ffaa00; }
  .btn-orange .btn-text { color: #ffaa00; }
</style>
<div class="go-panel">
  <span class="heading">SESSION COMPLETE</span>
  <span id="go-mode" class="mode-text">FREE FISH</span>
  <span id="go-score" class="score-big">0</span>
  <div class="stat-row">
    <span class="label">CAUGHT</span>
    <span id="go-caught" class="value">0</span>
  </div>
  <div class="stat-row">
    <span class="label">TOTAL WEIGHT</span>
    <span id="go-weight" class="value">0 kg</span>
  </div>
  <div class="stat-row">
    <span class="label">BEST COMBO</span>
    <span id="go-combo" class="value">0</span>
  </div>
  <div class="stat-row">
    <span class="label">CASTS</span>
    <span id="go-casts" class="value">0</span>
  </div>
  <div class="stat-row">
    <span class="label">LINE SNAPS</span>
    <span id="go-snaps" class="value">0</span>
  </div>
  <div id="btn-rematch" class="btn">
    <span class="btn-text">FISH AGAIN</span>
  </div>
  <div id="btn-title" class="btn btn-orange">
    <span class="btn-text">TITLE</span>
  </div>
</div>
