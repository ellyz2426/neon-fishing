<style>
  .bait-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 3;
    padding-right: 3;
    background-color: rgba(0, 10, 20, 0.95);
    border-color: #44ff44;
    border-width: 0.1;
    border-radius: 1.5;
  }
  .heading { font-size: 2.5; color: #44ff44; font-weight: bold; }
  .subtitle { font-size: 1.2; color: #44aaaa; margin-top: 0.3; }
  .bait-item {
    display: flex;
    flex-direction: column;
    margin-top: 0.8;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(0, 40, 20, 0.5);
    border-color: #338833;
    border-width: 0.05;
    border-radius: 0.5;
    cursor: pointer;
  }
  .bait-name { font-size: 1.5; color: #44ff44; font-weight: bold; }
  .bait-desc { font-size: 1; color: #668888; margin-top: 0.2; }
  .bait-status { font-size: 1; color: #ffaa00; margin-top: 0.2; }
  .back-btn {
    margin-top: 1.5;
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(60, 30, 0, 0.6);
    border-color: #ffaa00;
    border-width: 0.05;
    border-radius: 0.5;
    cursor: pointer;
  }
  .back-text { font-size: 1.3; color: #ffaa00; }
</style>
<div class="bait-panel">
  <span class="heading">TACKLE BOX</span>
  <span class="subtitle">Select your bait</span>
  <div id="btn-bait-0" class="bait-item">
    <span id="bait-name-0" class="bait-name">---</span>
    <span id="bait-desc-0" class="bait-desc">---</span>
    <span id="bait-status-0" class="bait-status">---</span>
  </div>
  <div id="btn-bait-1" class="bait-item">
    <span id="bait-name-1" class="bait-name">---</span>
    <span id="bait-desc-1" class="bait-desc">---</span>
    <span id="bait-status-1" class="bait-status">---</span>
  </div>
  <div id="btn-bait-2" class="bait-item">
    <span id="bait-name-2" class="bait-name">---</span>
    <span id="bait-desc-2" class="bait-desc">---</span>
    <span id="bait-status-2" class="bait-status">---</span>
  </div>
  <div id="btn-bait-3" class="bait-item">
    <span id="bait-name-3" class="bait-name">---</span>
    <span id="bait-desc-3" class="bait-desc">---</span>
    <span id="bait-status-3" class="bait-status">---</span>
  </div>
  <div id="btn-bait-4" class="bait-item">
    <span id="bait-name-4" class="bait-name">---</span>
    <span id="bait-desc-4" class="bait-desc">---</span>
    <span id="bait-status-4" class="bait-status">---</span>
  </div>
  <div id="btn-bait-5" class="bait-item">
    <span id="bait-name-5" class="bait-name">---</span>
    <span id="bait-desc-5" class="bait-desc">---</span>
    <span id="bait-status-5" class="bait-status">---</span>
  </div>
  <div id="btn-back-bait" class="back-btn">
    <span class="back-text">BACK</span>
  </div>
</div>
