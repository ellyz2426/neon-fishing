<style>
  .diff-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 3;
    padding-bottom: 3;
    padding-left: 4;
    padding-right: 4;
    background-color: rgba(0, 10, 20, 0.9);
    border-color: #00ffff;
    border-width: 0.1;
    border-radius: 1.5;
  }
  .heading {
    font-size: 3;
    color: #00ffff;
    font-weight: bold;
  }
  .btn {
    margin-top: 1.2;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 4;
    padding-right: 4;
    background-color: rgba(0, 60, 60, 0.6);
    border-color: #00aaaa;
    border-width: 0.05;
    border-radius: 0.5;
    cursor: pointer;
  }
  .btn-text { font-size: 2; color: #00ffff; font-weight: bold; }
  .btn-green { background-color: rgba(0, 80, 0, 0.5); border-color: #44ff44; }
  .btn-green .btn-text { color: #44ff44; }
  .btn-red { background-color: rgba(80, 0, 0, 0.5); border-color: #ff4444; }
  .btn-red .btn-text { color: #ff4444; }
  .back-btn {
    margin-top: 1.5;
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(60, 30, 0, 0.6);
    border-color: #ffaa00;
    border-width: 0.05;
    border-radius: 0.5;
    cursor: pointer;
  }
  .back-text { font-size: 1.3; color: #ffaa00; }
</style>
<div class="diff-panel">
  <span class="heading">DIFFICULTY</span>
  <div id="btn-easy" class="btn btn-green">
    <span class="btn-text">EASY</span>
  </div>
  <div id="btn-medium" class="btn">
    <span class="btn-text">MEDIUM</span>
  </div>
  <div id="btn-hard" class="btn btn-red">
    <span class="btn-text">HARD</span>
  </div>
  <div id="btn-back-diff" class="back-btn">
    <span class="back-text">BACK</span>
  </div>
</div>
