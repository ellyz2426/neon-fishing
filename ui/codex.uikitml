<style>
  .codex-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(0, 10, 20, 0.95);
    border-color: #44ff44;
    border-width: 0.1;
    border-radius: 1.5;
  }
  .heading { font-size: 2.5; color: #44ff44; font-weight: bold; }
  .count { font-size: 1.3; color: #668888; margin-top: 0.3; }
  .fish-entry {
    display: flex;
    flex-direction: row;
    margin-top: 0.4;
    padding-top: 0.3;
    padding-bottom: 0.3;
    padding-left: 1;
    padding-right: 1;
    background-color: rgba(0, 30, 30, 0.4);
    border-radius: 0.3;
  }
  .fish-name { font-size: 1.2; color: #00ffff; }
  .fish-rarity { font-size: 1; color: #668888; margin-left: 1; }
  .back-btn {
    margin-top: 1;
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(60, 30, 0, 0.6);
    border-color: #ffaa00;
    border-width: 0.05;
    border-radius: 0.5;
    cursor: pointer;
  }
  .back-text { font-size: 1.3; color: #ffaa00; }
</style>
<div class="codex-panel">
