<style>
  .lb-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(0, 10, 20, 0.95);
    border-color: #aa44ff;
    border-width: 0.1;
    border-radius: 1.5;
  }
  .heading { font-size: 2.5; color: #aa44ff; font-weight: bold; }
  .entry {
    display: flex;
    flex-direction: row;
    margin-top: 0.4;
    padding-top: 0.2;
    padding-bottom: 0.2;
    padding-left: 0.5;
    padding-right: 0.5;
    background-color: rgba(20, 0, 40, 0.4);
    border-radius: 0.3;
  }
  .rank { font-size: 1.2; color: #aa44ff; font-weight: bold; }
  .score { font-size: 1.2; color: #00ffff; margin-left: 1; }
  .mode { font-size: 1; color: #668888; margin-left: 1; }
  .date { font-size: 1; color: #555555; margin-left: 1; }
  .back-btn {
    margin-top: 1;
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(60, 30, 0, 0.6);
    border-color: #ffaa00;
    border-width: 0.05;
    border-radius: 0.5;
    cursor: pointer;
  }
  .back-text { font-size: 1.3; color: #ffaa00; }
</style>
<div class="lb-panel">
  <span class="heading">LEADERBOARD</span>
  <div class="entry"><span id="lb-rank-0" class="rank"></span><span id="lb-score-0" class="score"></span><span id="lb-mode-0" class="mode"></span><span id="lb-date-0" class="date"></span></div>
  <div class="entry"><span id="lb-rank-1" class="rank"></span><span id="lb-score-1" class="score"></span><span id="lb-mode-1" class="mode"></span><span id="lb-date-1" class="date"></span></div>
  <div class="entry"><span id="lb-rank-2" class="rank"></span><span id="lb-score-2" class="score"></span><span id="lb-mode-2" class="mode"></span><span id="lb-date-2" class="date"></span></div>
  <div class="entry"><span id="lb-rank-3" class="rank"></span><span id="lb-score-3" class="score"></span><span id="lb-mode-3" class="mode"></span><span id="lb-date-3" class="date"></span></div>
  <div class="entry"><span id="lb-rank-4" class="rank"></span><span id="lb-score-4" class="score"></span><span id="lb-mode-4" class="mode"></span><span id="lb-date-4" class="date"></span></div>
  <div class="entry"><span id="lb-rank-5" class="rank"></span><span id="lb-score-5" class="score"></span><span id="lb-mode-5" class="mode"></span><span id="lb-date-5" class="date"></span></div>
  <div class="entry"><span id="lb-rank-6" class="rank"></span><span id="lb-score-6" class="score"></span><span id="lb-mode-6" class="mode"></span><span id="lb-date-6" class="date"></span></div>
  <div class="entry"><span id="lb-rank-7" class="rank"></span><span id="lb-score-7" class="score"></span><span id="lb-mode-7" class="mode"></span><span id="lb-date-7" class="date"></span></div>
  <div class="entry"><span id="lb-rank-8" class="rank"></span><span id="lb-score-8" class="score"></span><span id="lb-mode-8" class="mode"></span><span id="lb-date-8" class="date"></span></div>
  <div class="entry"><span id="lb-rank-9" class="rank"></span><span id="lb-score-9" class="score"></span><span id="lb-mode-9" class="mode"></span><span id="lb-date-9" class="date"></span></div>
  <div id="btn-back-leaderboard" class="back-btn">
    <span class="back-text">BACK</span>
  </div>
</div>
