<style>
  .tutorial-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 4;
    padding-right: 4;
    background-color: rgba(0, 10, 30, 0.95);
    border-color: #ffaa00;
    border-width: 0.1;
    border-radius: 1.5;
  }
  .heading { font-size: 2.5; color: #ffaa00; font-weight: bold; }
  .step-num { font-size: 3; color: #00ffff; font-weight: bold; margin-top: 1; }
  .step-title { font-size: 2; color: #00ffff; font-weight: bold; margin-top: 0.5; }
  .step-desc { font-size: 1.3; color: #88aaaa; margin-top: 0.5; }
  .step-input { font-size: 1.5; color: #ffaa00; font-weight: bold; margin-top: 0.8; }
  .progress { font-size: 1; color: #668888; margin-top: 1; }
  .btn {
    margin-top: 1;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(60, 40, 0, 0.6);
    border-color: #ffaa00;
    border-width: 0.05;
    border-radius: 0.5;
    cursor: pointer;
  }
  .btn-text { font-size: 1.3; color: #ffaa00; }
</style>
<div class="tutorial-panel">
  <span class="heading">HOW TO FISH</span>
  <span id="tut-step-num" class="step-num">1</span>
  <span id="tut-step-title" class="step-title">CAST YOUR LINE</span>
  <span id="tut-step-desc" class="step-desc">Hold SPACE or TRIGGER to charge, release to cast</span>
  <span id="tut-step-input" class="step-input">SPACE / TRIGGER</span>
  <span id="tut-progress" class="progress">Step 1 of 4</span>
  <div id="btn-tut-skip" class="btn">
    <span class="btn-text">SKIP TUTORIAL</span>
  </div>
</div>
